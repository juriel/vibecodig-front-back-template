DATABASE_URL=mysql+pymysql://user:password@localhost/dbname
# Token signing key: generate with  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Root of the media manager's virtual file system (vfs.path is relative to it)
VFS_PATH=/opt/vfs
# Language of the published site content (<html lang="...">); independent from the admin UI language
SITE_LANG=en

# AI assistant (optional). Without a key the panel works normally and the AI buttons say it is not configured.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_DRAFT_MODEL=claude-opus-5-5        # page drafts
# AI_COMPLETE_MODEL=claude-haiku-5-5    # inline suggestions while typing (fast, cheap)
