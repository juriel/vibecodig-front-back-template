DATABASE_URL=mysql+pymysql://user:password@localhost/dbname
# Token signing key: generate with  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Root of the media manager's virtual file system (vfs.path is relative to it)
VFS_PATH=/opt/vfs
# Language of the published site content (<html lang="...">); independent from the admin UI language
SITE_LANG=en
