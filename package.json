{
  "name": "vibecodig-front-back-template",
  "private": true,
  "scripts": {
    "install:all": "pip install -r requirements.txt && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev:front": "npm --prefix frontend run dev",
    "dev:back": "uvicorn server:app --reload --reload-dir backend --reload-dir . --host 0.0.0.0 --port 8000",
    "start": "npm run build && uvicorn server:app --host 0.0.0.0 --port 8000"
  }
}
